{
  "name": "ansight-replay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Ansight replay scrubber with touches and native annotations for MCP Apps",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
