    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/test-live.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "5.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
